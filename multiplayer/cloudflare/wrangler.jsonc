{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shadow-run-rooms",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-23",
  "workers_dev": true,
  "observability": {
    "enabled": false
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "PROGRESS",
        "class_name": "ProgressRegistry"
      },
      {
        "name": "BACKUP",
        "class_name": "BackupRegistry"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "RoomRegistry"
      ]
    },
    {
      "tag": "v2",
      "new_sqlite_classes": [
        "GameRelay"
      ]
    },
    {
      "tag": "v3",
      "new_sqlite_classes": [
        "CollectorRegistry"
      ]
    },
    {
      "tag": "v4",
      "new_sqlite_classes": [
        "ProgressRegistry"
      ]
    },
    {
      "tag": "v5",
      "new_sqlite_classes": [
        "DraftRegistry"
      ]
    },
    {
      "tag": "v6",
      "new_sqlite_classes": [
        "BackupRegistry"
      ]
    },
    {
      "tag": "v7",
      "deleted_classes": [
        "RoomRegistry",
        "GameRelay",
        "CollectorRegistry",
        "DraftRegistry"
      ]
    }
  ]
}
